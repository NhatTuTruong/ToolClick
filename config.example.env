# Sao chép thành .env và chỉnh nếu cần
HEADLESS=true
GOOGLE_LOCALE=vi-VN
# Chọn nhanh trên UI (60 thị trường) hoặc gõ tay: en-US, tr-TR, de-DE, ...
# Vùng ads (mặc định lấy từ locale, VD vi-VN → hl=vi gl=VN)
# GOOGLE_HL=vi
# GOOGLE_GL=VN
# Host search: trống = google.com.vn khi GL=VN
# GOOGLE_HOST=www.google.com.vn
GOOGLE_TIMEZONE=Asia/Ho_Chi_Minh
SEARCH_DELAY_MS=1500
# chrome | msedge | auto | chromium — chrome gần trình duyệt thật nhất
BROWSER_CHANNEL=chrome
# UA thật của Chrome (để trống = không ghi đè)
# BROWSER_USER_AGENT=
# true = viewport lớn, ẩn webdriver, search google.com.vn, profile cố định mặc định
REALISTIC_BROWSER=true
# true = thư mục browser-profile/ (cookie, login) — ads nhiều hơn session trống
USE_PERSISTENT_PROFILE=true
USER_DATA_DIR=browser-profile
CAPTCHA_WAIT_SEC=300
ORGANIC_DWELL_MS=2000
ORGANIC_CLICK_DELAY_MS=800
# false = không cho click quảng cáo. true + --click-sponsored-test = test click Sponsored
ENABLE_SPONSORED_CLICK_TEST=false
SPONSORED_DWELL_MS=1000
SPONSORED_CLICK_DELAY_MS=300
# Mỗi quảng cáo mở tab mới — tab SERP không go_back/reload (khuyên dùng)
SPONSORED_OPEN_NEW_TAB=true
SPONSORED_NEW_TAB_TIMEOUT_MS=25000
# Chờ tối đa ads hiện lại sau go_back (giữa các click)
SPONSORED_SERP_READY_MS=5000
# 0 = click hết quảng cáo tìm thấy khi dùng --click-sponsored-test
MAX_SPONSORED_CLICKS=0
# Số lần tải SERP mới khi click ads test (1 = chỉ SERP sau search đầu)
SERP_REPEAT_COUNT=1
# Domain được phép click (phẩy); để trống = mọi quảng cáo
ALLOWED_CLICK_DOMAINS=
# Domain không click (phẩy); quảng cáo thuộc các domain này bị bỏ qua
SKIP_CLICK_DOMAINS=
# Proxy xoay vòng theo SERP (| hoặc xuống dòng trong UI); để trống = không proxy
PROXY_LIST=
# Timeout mở Google qua proxy (ms), mặc định 120000
PROXY_NAV_TIMEOUT_MS=90000
# Chờ sau khi SERP hiện khung (#rso), ms
PROXY_SERP_WAIT_MS=20000
# Giới hạn sleep sau search khi dùng proxy (ms)
PROXY_SEARCH_DELAY_MS=1200
# serp = doi proxy moi vong SERP; keyword = doi proxy moi tu khoa (it CAPTCHA hon)
PROXY_ROTATE_MODE=keyword
# Profile Chrome rieng tung proxy (cookie lau dai) — true khuyen dung
PROXY_PERSIST_PROFILE=true
# open_browser.py: true = lam nong lan luot moi proxy trong PROXY_LIST
PROXY_WARMUP_ALL=false
# Key bản quyền (license-server Laravel)
LICENSE_SERVER_URL=http://127.0.0.1:8000
LICENSE_KEY=
LICENSE_API_SECRET=
